# ==================== 大模型 (LLM) 配置 ====================
# 通义千问 (DashScope) 兼容接口 Key
OPENAI_API_KEY=your_dashscope_api_key_here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen3.7-flash
EVAL_MODEL_NAME=qwen3.7-flash

# ==================== 向量化 (Embedding) 配置 ====================
# 可选: 'local' (本地离线BGE模型，免联网不掉线) 或 'dashscope' (调用在线API)
EMBEDDING_PROVIDER=local
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# 支持 HuggingFace 模型标识 (如 BAAI/bge-large-zh-v1.5) 或本地绝对路径
LOCAL_EMBEDDING_PATH=BAAI/bge-large-zh-v1.5

# ==================== 向量数据库配置 ====================
# 可选: 'milvus' (默认，独立服务端口 19530) 或 'chroma' (轻量嵌入式持久化)
VECTOR_STORE_TYPE=milvus
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_URI=http://127.0.0.1:19530

# ==================== 关系型数据库 (元数据与会话管理) ====================
# 优先 MySQL，连接失败将自动降级为本地 SQLite (无需担心本地无 MySQL 服务)
DB_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=rag

# ==================== 父子分块与检索参数 ====================
PARENT_CHUNK_SIZE=1500
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=60
RETRIEVAL_INITIAL_TOP_K=16
TOP_K=4
HYBRID_SEARCH_RATIO=0.5

# ==================== Reranker 交叉重排模型配置 ====================
# 是否启用 Cross-Encoder 精排模型 (若在离线或无外网环境，可设为 false 自动回退初筛结果)
RERANKER_ENABLED=true
# 支持本地物理路径或 HuggingFace 模型标识 (如 BAAI/bge-reranker-base)
RERANKER_MODEL_PATH=BAAI/bge-reranker-base

# ==================== CRAG 自校正与反思参数 ====================
MAX_RETRIES=3
ENABLE_WEB_SEARCH=true

# ==================== 服务端口与日志 ====================
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
