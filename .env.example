# ==================== Large Language Model (LLM) Configuration ====================
# DashScope OpenAI-compatible API Key
OPENAI_API_KEY=your_dashscope_api_key_here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen3.7-flash
EVAL_MODEL_NAME=qwen3.7-flash

# ==================== Embedding Configuration ====================
# Options: 'local' (offline local BGE model) or 'dashscope' (online API)
EMBEDDING_PROVIDER=local
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# Supports HuggingFace model repo id (e.g. BAAI/bge-large-zh-v1.5) or local absolute path
LOCAL_EMBEDDING_PATH=BAAI/bge-large-zh-v1.5

# ==================== Vector Database Configuration ====================
# Options: 'milvus' (default, port 19530) or 'chroma' (lightweight embedded persistent)
VECTOR_STORE_TYPE=milvus
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_URI=http://127.0.0.1:19530

# ==================== Relational Database (Metadata & Session Management) ====================
# Preferred: MySQL. Automatically falls back to local SQLite if connection fails.
DB_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=rag

# ==================== Parent-Child Chunking & Retrieval Parameters ====================
PARENT_CHUNK_SIZE=1500
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=60
RETRIEVAL_INITIAL_TOP_K=16
TOP_K=4
HYBRID_SEARCH_RATIO=0.5

# ==================== Cross-Encoder Reranker Configuration ====================
# Enable Cross-Encoder reranking model (set to false to fall back to initial retrieval if offline)
RERANKER_ENABLED=true
# Supports local path or HuggingFace repo id (e.g. BAAI/bge-reranker-base)
RERANKER_MODEL_PATH=BAAI/bge-reranker-base

# ==================== CRAG Self-Correction & Reflection Parameters ====================
MAX_RETRIES=3
ENABLE_WEB_SEARCH=true

# ==================== Service Ports & Logging ====================
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
